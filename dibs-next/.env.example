# Copy to .env.local for local overrides. Never commit real secrets.
# These are the only variables the code reads. The same names are set in the Vercel project.

# Data source on first load: demo (fixtures in lib/demo, read only) or live (lib/live with Supabase).
# The preview panel at /dev can switch it per browser.
NEXT_PUBLIC_DATA_SOURCE=demo

# true shows the dev toolbar and the preview panel at /dev. Leave unset or false in production.
NEXT_PUBLIC_DEV_TOOLBAR=true

# Supabase project URL and its publishable (public) key. Both are safe to expose to the browser.
# The older name NEXT_PUBLIC_SUPABASE_ANON_KEY is read as a fallback for the key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional, server only. Pins "now" for prices, tiers and deadlines. Use an ISO timestamp with an offset.
# Leave unset to use the real clock.
# DIBS_AS_OF=2027-04-01T12:00:00-07:00
